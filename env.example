# AI-Рейдер — конфигурация запуска. Скопируй в .env и заполни ОДИН блок провайдера.
#   cp env.example .env   &&   отредактируй .env
# run-scan.sh / run-scan-local.sh подхватят .env автоматически.
#
# Модель — любой id LiteLLM (https://docs.litellm.ai/docs/providers).
# Раскомментируй один блок ниже (убери # в начале строк).

# ── OpenAI ────────────────────────────────────────────────
# AIRAIDER_LLM=openai/gpt-5.4
# OPENAI_API_KEY=sk-...

# ── Anthropic (Claude) ────────────────────────────────────
# AIRAIDER_LLM=anthropic/claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini (есть бесплатный тариф в Google AI Studio) ─
# AIRAIDER_LLM=gemini/gemini-2.5-pro
# GEMINI_API_KEY=...

# ── OpenRouter (много моделей одним ключом) ───────────────
# AIRAIDER_LLM=openrouter/z-ai/glm-5.3
# OPENROUTER_API_KEY=sk-or-...

# ── Локально, без ключа и без утечки данных (Ollama) ──────
#   ollama serve   &&   ollama pull qwen2.5:32b
# AIRAIDER_LLM=ollama/qwen2.5:32b
# LLM_API_BASE=http://localhost:11434

# ── Любой OpenAI-совместимый эндпоинт (LM Studio, vLLM, шлюз) ─
# AIRAIDER_LLM=openai/<имя-модели>
# LLM_API_KEY=<ключ-или-любая-строка>
# LLM_API_BASE=http://localhost:1234/v1

# ── Необязательно: лимиты песочницы (защита хоста) ────────
# AIRAIDER_SANDBOX_MEM_LIMIT=4g
# AIRAIDER_SANDBOX_CPUS=2
# AIRAIDER_SANDBOX_PIDS_LIMIT=512

# ── Необязательно: свой sandbox-образ ─────────────────────
# AIRAIDER_IMAGE=ai-raider-sandbox:0.1.0
