# AI-Raider run configuration. Copy to .env and fill in ONE provider block.
#   cp env.example .env   &&   edit .env
# run-scan.sh / run-scan-local.sh pick up .env automatically.
#
# The model is any LiteLLM id (https://docs.litellm.ai/docs/providers).
# Uncomment one block below (remove the leading #).

# -- OpenAI --------------------------------------------------
# AIRAIDER_LLM=openai/gpt-5.4
# OPENAI_API_KEY=sk-...

# -- Anthropic (Claude) --------------------------------------
# AIRAIDER_LLM=anthropic/claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# -- Google Gemini (has a free tier in Google AI Studio) -----
# AIRAIDER_LLM=gemini/gemini-2.5-pro
# GEMINI_API_KEY=...

# -- OpenRouter (many models, one key) -----------------------
# AIRAIDER_LLM=openrouter/z-ai/glm-5.3
# OPENROUTER_API_KEY=sk-or-...

# -- Local, no key and no data leaving your machine (Ollama) --
#   ollama serve   &&   ollama pull qwen2.5:32b
# AIRAIDER_LLM=ollama/qwen2.5:32b
# LLM_API_BASE=http://localhost:11434

# -- Any OpenAI-compatible endpoint (LM Studio, vLLM, gateway) --
# AIRAIDER_LLM=openai/<model-name>
# LLM_API_KEY=<key-or-any-string>
# LLM_API_BASE=http://localhost:1234/v1

# -- Optional: sandbox limits (protect the host) -------------
# AIRAIDER_SANDBOX_MEM_LIMIT=4g
# AIRAIDER_SANDBOX_CPUS=2
# AIRAIDER_SANDBOX_PIDS_LIMIT=512

# -- Optional: your own sandbox image ------------------------
# AIRAIDER_IMAGE=ai-raider-sandbox:0.1.0
